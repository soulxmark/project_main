<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
            http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>FinancialApp</display-name>

    <welcome-file-list>
        <welcome-file>dashboard.jsp</welcome-file>
    </welcome-file-list>

    <!-- Branch servlet -->
    <servlet>
        <servlet-name>BranchServlet</servlet-name>
        <servlet-class>com.example.controller.BranchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BranchServlet</servlet-name>
        <url-pattern>/branches</url-pattern>
    </servlet-mapping>

    <!-- Income servlet -->
    <servlet>
        <servlet-name>IncomeServlet</servlet-name>
        <servlet-class>com.example.controller.IncomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncomeServlet</servlet-name>
        <url-pattern>/incomes</url-pattern>
    </servlet-mapping>

    <!-- Expense servlet -->
    <servlet>
        <servlet-name>ExpenseServlet</servlet-name>
        <servlet-class>com.example.controller.ExpenseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExpenseServlet</servlet-name>
        <url-pattern>/expenses</url-pattern>
    </servlet-mapping>

    <!-- Balance servlet -->
    <servlet>
        <servlet-name>BalanceServlet</servlet-name>
        <servlet-class>com.example.controller.BalanceSheetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BalanceServlet</servlet-name>
        <url-pattern>/balances</url-pattern>
    </servlet-mapping>

    <!-- Report servlet (dashboard) -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.example.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/report</url-pattern>
    </servlet-mapping>

</web-app>
